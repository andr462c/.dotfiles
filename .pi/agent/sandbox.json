{
  "enabled": true,
  "permissionPromptTimeoutSeconds": 600,
  "network": {
    "allowLocalBinding": true,
    "allowAllUnixSockets": true,
    "allowUnauthenticatedSocksProxy": true,
    "allowedDomains": [
      "localhost",
      "127.0.0.1",
      "github.com",
      "*.github.com",
      "raw.githubusercontent.com",
      "*.npmjs.org",
      "*.pypi.org"
    ],
    "deniedDomains": []
  },
  "filesystem": {
    "denyRead": [
      ".env",
      ".env.*",
      "*.pem",
      "*.key",
      "~/.ssh/*",
      "~/.gnupg/*"
    ],
    "allowRead": [
      ".",
      "/tmp",
      "~/.config",
      "~/.local",
      "~/.cache",
      "~/dev",
      "~/git"
    ],
    "allowWrite": [
      ".",
      "/tmp",
      "~/.pi/"
    ],
    "denyWrite": [
      ".env",
      ".env.*",
      "*.pem",
      "*.key"
    ]
  }
}
