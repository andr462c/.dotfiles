# Allowlist. The repo root is $HOME (git-dir: ~/.dotfiles), so everything is
# ignored except what is listed here. Fail-safe by direction: anything new that
# pi writes into ~/.pi stays ignored unless deliberately allowed.

/*

!/.gitignore
!/.dotfiles.d/
!/README.md

!/.vimrc
!/.gitconfig.common

!/.pi/
/.pi/*
!/.pi/agent/
/.pi/agent/*

# models.json holds an internal LLM hostname; only the template is tracked
!/.pi/agent/models.json.example

!/.pi/agent/settings.json
!/.pi/agent/keybindings.json
!/.pi/agent/sandbox.json

# Per-extension config, never logs or installed code. '*/*' rather than '*'
# because gitignore cannot re-include a file under an excluded directory, so
# each package dir must stay traversable for config.json to be allowed.
!/.pi/agent/extensions/
/.pi/agent/extensions/*/*
!/.pi/agent/extensions/*/config.json

# Never add: auth.json (credentials), sessions/ (history), install/ and npm/
# (regenerated by pi), ~/.vim/plugged/ (:PlugInstall), undo/backup/viminfo.
